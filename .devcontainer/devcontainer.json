{
    "name": "Zir Image Enhancer",
    "build": {
        "dockerfile": "Dockerfile",
        "context": "..",
        // The default dev image is lean (no torch/scorer). Set SCORER=1 to build the
        // heavier self-evaluation image that includes the `scorer` extra.
        "args": {
            "SCORER": "0"
        }
    },
    "mounts": [
        "source=zir-model-cache,target=/root/.cache,type=volume"
    ],
    "runArgs": [
        "--shm-size=8g"
    ],
    "containerEnv": {
        "GRADIO_SERVER_NAME": "0.0.0.0",
        "GRADIO_SERVER_PORT": "7860"
    },
    "forwardPorts": [
        7860
    ],
    "portsAttributes": {
        "7860": {
            "label": "Gradio Live Demo",
            "onAutoForward": "notify"
        }
    },
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-python.python",
                "ms-python.vscode-pylance",
                "charliermarsh.ruff",
                "sst-dev.opencode"
            ],
            "settings": {
                "python.defaultInterpreterPath": "/opt/venv/bin/python",
                "[python]": {
                    "editor.defaultFormatter": "charliermarsh.ruff",
                    "editor.formatOnSave": true,
                    "editor.codeActionsOnSave": {
                        "source.organizeImports.ruff": "explicit"
                    }
                }
            }
        }
    },
    "remoteUser": "root"
}