# Copy to .env (ignored by Git) and fill in. Never commit real keys.
FAL_KEY=

# Hard stop for fal spending, in USD, counted in local/fal_ledger.jsonl (team budget is $100).
ZIR_FAL_BUDGET_USD=70

# Model used by the pipeline: unset means the harness default (nano-banana 2.1 portrait).
# Set sartiq-lora-klein to use the fine-tuned packshot LoRA (docs/LORA.md); it needs an
# adapter in local/lora/registry.json (scripts/lora/register_lora.py) or ZIR_LORA_PATH,
# and the run stops with a clear error without one.
# ZIR_MODEL_KEY=sartiq-lora-klein

# Highest-priority adapter override: a fal URL, a HuggingFace repo id (owner/repo) or a
# local .safetensors path. ZIR_LORA_SCALE adjusts the strength (fal allows 0.0 to 4.0).
# ZIR_LORA_PATH=
# ZIR_LORA_SCALE=1.0

# Optional path overrides (defaults shown).
# ZIR_DATA_ROOT=data/sartiq_neural_wave_2026
# ZIR_STARTER_ROOT=local/neural-wave-2026
# ZIR_RUNS_ROOT=local/runs
