# Copy to .env (ignored by Git) and fill in. Never commit real keys.
FAL_KEY=

# Hard stop for fal spending, in USD, counted in local/fal_ledger.jsonl. The ledger uses
# estimated prices; check the real balance on fal.ai before raising it.
ZIR_FAL_BUDGET_USD=70

# Optional path overrides (defaults shown).
# ZIR_DATA_ROOT=data/sartiq_neural_wave_2026
# ZIR_STARTER_ROOT=local/neural-wave-2026
# ZIR_RUNS_ROOT=local/runs