# The build context is the whole repo, so without this file Docker would upload
# model weights, caches, generated outputs and datasets every time the image is built.
.git/
.github/
.venv/
.cache/
build/
dist/
*.egg-info/

# Tool caches and local agent state (never needed in the image, but huge if left in the
# build context every time a linter or the agent runs).
.mypy_cache/
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/
.opencode/
.claude/

# Datasets and generated outputs (never baked into the image)
data/
holdout/
predictions/
submissions/
val_out/
val_smoke/
val_hosted/
experiments/
local/
outputs/
runs/
*.log

# Model weights and caches (downloaded at runtime into a mounted cache)
**/__pycache__/
**/*.pth
**/*.pt
**/*.ckpt
**/*.safetensors
**/*.onnx
**/*.gguf
.gradio/
.env
# The vendored scorer's own model cache is downloaded at runtime, not baked in.
tools/scorer/.models/
# The vendored scorer is a path dependency, so tools/ itself must stay in the context.
