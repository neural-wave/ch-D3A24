# The build context is the whole repo, so without this file Docker would upload
# model weights, caches and outputs every time the image is built.
.git/
.cache/
.venv/
weights/
outputs/
runs/
data/
**/__pycache__/
**/*.pth
**/*.pt
**/*.ckpt
**/*.safetensors
**/*.onnx
**/*.gguf
.gradio/
.env
# Upstream clone (cached venv/weights) is not part of the build context.
local/
# Scorer weights are downloaded at runtime into a mounted cache, not baked in.
tools/scorer/.models/
